                 sbe02.rpc_state != RPC_ON)
        {
			           /* get s2 temp */
            sbe02.S2.actual_temp = move_average_filter(&s2_adc) >> 2;

            if (temp <= (sbe02.S2.set_temp + PID_RANGE) &&
