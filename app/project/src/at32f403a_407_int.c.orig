            time_count_ms = 0;
            time_count_s = 0;
        }
    }
}

uint16_t trimmed_average(uint16_t *arr, uint8_t len)
{
    uint16_t min_val = arr[0];
    uint16_t max_val = arr[0];
    uint16_t sum = arr[0];

    for (int i = 1; i < len; i++)
    {
        sum += arr[i];

        if (arr[i] < min_val)
        {
            min_val = arr[i];
        }

        if (arr[i] > max_val)
        {
            max_val = arr[i];
        }
    }

    uint16_t adjusted_sum = sum - min_val - max_val;
    return (uint16_t)adjusted_sum / len - 2;
}

int8_t linear_correction(uint16_t user_set_temp)
{
    volatile uint8_t n = 0;
    volatile uint16_t check_start = 0;
    volatile uint8_t check_value = 0;
    check_value = 0;
    check_start = 200;

    for (n = 0; n < 26; n++)
    {
        if (user_set_temp <= (check_start + check_value))
        {
            return (offset_table[n]);
        }
        else
        {
            check_start += 10;
        }
    }

    return (offset_table[n]);
}

