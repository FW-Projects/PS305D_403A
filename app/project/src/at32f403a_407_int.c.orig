            {
                sbe02.S2.pwm_out = 0;
            }
            else
            {
                if (sbe02.S2.handle_type == TPYE_245)
                {
                    sbe02.S2.pwm_out = 60000;
                }
                else if (sbe02.S2.handle_type == TPYE_210)
                {
                    sbe02.S2.pwm_out = 30000;
                }
            }

            s2_run_flag = false;
            delay_time = 3;
            state = 0;
            break;
         }

        break;
    }

#endif
}

void s1_sleep_control(void)
{
    static bool first_in = false;
    static uint16_t time_count_ms = 0;
    static uint8_t time_count_s = 0;

    if (sbe02.S1.handle_position == IN_POSITION)
    {
        first_in = false;

        if (sbe02.S1.sleep_time_count)
        {
            time_count_ms++;

            if (time_count_ms >= 1000)
            {
                time_count_ms = 0;
                time_count_s++;

                if (time_count_s >= 60)
                {
                    time_count_s = 0;
                    sbe02.S1.sleep_time_count--;
                }
            }
        }
        else
        {
            if (sbe02.S1.handle_state == WORKING)
            {
                sbe02.S1.handle_state = SLEEP;
            }
        }
    }
    else if (sbe02.S1.handle_position == NOT_IN_POSITION)
    {
        if (first_in == false)
        {
            first_in = true;
            sbe02.S1.handle_state = WORKING;
            sbe02.S1.sleep_time_count = sbe02.S1.set_sleep_time;
            time_count_ms = 0;
            time_count_s = 0;
        }
    }
}

