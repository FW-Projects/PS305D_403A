/**
  * @brief  this function handles systick handler.
  * @param  none
  * @retval none
  */
void SysTick_Handler(void)
{
    /* add user code begin SysTick_IRQ 0 */
    static uint8_t beep_run_time = BEEP_TASK_TIME;
    static uint16_t get_temp_time = GET_MCU_TEMP_TIME;
    static uint8_t beep_warning_time = 10;
    /* run beep function */
    beep_run_time--;

    if (!beep_run_time)
    {
        beep_run_time = BEEP_TASK_TIME;

        if (sbe02.fuction.beep == BEEP_ON)
        {
            beep_handle();

            if (sbe02.S1.handle_error != HANDLE_OK ||
                    sbe02.S2.handle_error != HANDLE_OK)
            {
                beep_warning_time --;

                if (!beep_warning_time)
                {
                    beep_warning_time = 40;
                    sbeep.status = BEEP_LONG;
                }
            }
        }
    }

    /* get mcu temp */
    get_temp_time--;

    if (!get_temp_time)
    {
        adc1_ordinary_value = get_adcval(ADC_CHANNEL_16);
        sbe02.mcu_temp = (ADC_TEMP_BASE - (double)adc1_ordinary_value * ADC_VREF / 4096) / ADC_TEMP_SLOPE + 25;
        get_temp_time = GET_MCU_TEMP_TIME;
    }

    tmt.tick();
    s1_sleep_control();
    s2_sleep_control();
    s1_pwm_control();
    s2_pwm_control();
    /* add user code end SysTick_IRQ 0 */
    wk_timebase_handler();
    /* add user code begin SysTick_IRQ 1 */
    /* add user code end SysTick_IRQ 1 */
}

/**
  * @brief  this function handles EXINT Line [9:5] handler.
  * @param  none
  * @retval none
  */
void EXINT9_5_IRQHandler(void)
{
    /* add user code begin EXINT9_5_IRQ 0 */
    if (exint_flag_get(EXINT_LINE_6) != RESET)
    {
#if 1

        /* s1 handle output */
        if (s1_run_flag == false)
        {
            if (sbe02.S1.handle_state == SLEEP ||
                    sbe02.S1.handle_error != HANDLE_OK)
            {
                sbe02.S1.pwm_out = 0;
                PID_Clear_I(&s1_210_pid);
                PID_Clear_I(&s1_245_pid);
                tmr_channel_value_set(TMR2, TMR_SELECT_CHANNEL_1, 0);
                // z tmr_counter_enable(TMR2, TRUE);
            }
            else if (sbe02.S1.handle_state == WORKING)
            {
                tmr_channel_value_set(TMR2, TMR_SELECT_CHANNEL_1, sbe02.S1.pwm_out);
                tmr_counter_enable(TMR2, TRUE);
            }

            s1_run_flag = true;
        }

#endif
#if 1

        /* s2 handle output */
        if (s2_run_flag == false)
        {
            if (sbe02.S2.handle_state == SLEEP ||
                    sbe02.S2.handle_error != HANDLE_OK)
            {
                sbe02.S2.pwm_out = 0;
                PID_Clear_I(&s2_210_pid);
                PID_Clear_I(&s2_245_pid);
                tmr_channel_value_set(TMR2, TMR_SELECT_CHANNEL_2, 0);
                // tmr_counter_enable(TMR2, TRUE);
            }
            else if (sbe02.S2.handle_state == WORKING)
            {
                tmr_channel_value_set(TMR2, TMR_SELECT_CHANNEL_2, sbe02.S2.pwm_out);
                tmr_counter_enable(TMR2, TRUE);
            }

            s2_run_flag = true;
        }

#endif

        if (sbe02.S1.handle_state == SLEEP && sbe02.S2.handle_state == SLEEP)
        {
            sbe02.S1.pwm_out = 0;
            sbe02.S2.pwm_out = 0;
            PID_Clear_I(&s1_210_pid);
            PID_Clear_I(&s2_245_pid);
            PID_Clear_I(&s2_210_pid);
            PID_Clear_I(&s2_245_pid);
            tmr_channel_value_set(TMR2, TMR_SELECT_CHANNEL_1, 0);
            tmr_channel_value_set(TMR2, TMR_SELECT_CHANNEL_2, 0);
            tmr_counter_enable(TMR2, false);
        }

        exint_flag_clear(EXINT_LINE_6);
    }

    /* add user code end EXINT9_5_IRQ 0 */
    /* add user code begin EXINT9_5_IRQ 1 */
    /* add user code end EXINT9_5_IRQ 1 */
}


/* add user code begin 1 */

void s1_pwm_control(void)
{
#if 1
    static handle_type_e last_s1_handle_type = RESET_VALUE;
    static uint8_t state = 0;
    static int8_t delay_time = 0;
    static uint16_t last_s1_set_temp = 0;
    static float temp = 0;

    if (sbe02.S1.handle_type == TPYE_210)
    {
        temp = sbe02.S1.actual_temp + sbe02.S1.line_cal_temp - sbe02.S1.cal_temp;
    }
    else if (sbe02.S1.handle_type == TPYE_245)
    {
        temp = sbe02.S1.actual_temp - sbe02.S1.cal_temp;
    }

    if (last_s1_set_temp != sbe02.S1.set_temp)
    {
        PID_Clear_I(&s1_210_pid);
        PID_Clear_I(&s1_245_pid);

        if (sbe02.S1.handle_type == TPYE_210)
        {
            sbe02.S1.line_cal_temp = linear_correction(sbe02.S1.set_temp);
        }

        last_s1_set_temp = sbe02.S1.set_temp;
    }

    if (last_s1_handle_type != sbe02.S1.handle_type)
    {
        if (sbe02.S1.handle_type == TPYE_210)
        {
            PID_Clear_I(&s1_210_pid);
            gpio_bits_reset(COM1_EN_GPIO_PORT, COM1_EN_PIN);
        }
        else if (sbe02.S1.handle_type == TPYE_245)
        {
            PID_Clear_I(&s1_245_pid);
            gpio_bits_set(COM1_EN_GPIO_PORT, COM1_EN_PIN);
        }

        last_s1_handle_type = sbe02.S1.handle_type;
    }

    switch (state)
    {
    case 0:
        if (s1_run_flag == true)
        {
            /* close s1 output */
            //tmr_channel_value_set(TMR2, TMR_SELECT_CHANNEL_1, 0);
            //tmr_counter_enable(TMR2, FALSE);
            /* delay some time */
            delay_time--;

            if (delay_time <= 0)
            {
                state++;
                break;
            }
        }

        break;

    case 1:
        if (sbe02.S1.handle_state == SLEEP)
        {
            /* get s1 temp */
            sbe02.S1.actual_temp = move_average_filter(&s1_adc) >> 2;
            s1_run_flag = false;
            state = 0;
            delay_time = 8;
            break;
        }
        else if (sbe02.S1.handle_state == WORKING &&
                 sbe02.S1.handle_error == HANDLE_OK &&
                 sbe02.S1.handle_type != TPYE_NOT_EXIST &&
                 sbe02.rpc_state != RPC_ON)
        {
            /* get s1 temp */
            sbe02.S1.actual_temp = move_average_filter(&s1_adc) >> 2;

            if (temp <= (sbe02.S1.set_temp + PID_RANGE) &&
                    temp >= (sbe02.S1.set_temp - PID_RANGE))
            {
                if (sbe02.S1.handle_type == TPYE_245)
                {
                    sbe02.S1.pwm_out = PID_Position_Calc(&s1_245_pid, sbe02.S1.set_temp,
                                                         temp);
                }
                else if (sbe02.S1.handle_type == TPYE_210)
                {
                    sbe02.S1.pwm_out = PID_Position_Calc(&s1_210_pid, sbe02.S1.set_temp,
                                                         temp);
                }
            }
            else if (temp > (sbe02.S1.set_temp + PID_RANGE))
            {
                sbe02.S1.pwm_out = 0;
            }
            else
            {
                if (sbe02.S1.handle_type == TPYE_245)
                {
                    sbe02.S1.pwm_out = 60000;
                }
                else if (sbe02.S1.handle_type == TPYE_210)
                {
                    sbe02.S1.pwm_out = 30000;
                }
            }

            s1_run_flag = false;
            delay_time = 3;
            state = 0;
            break;
        }

        break;
    }

#endif
}

